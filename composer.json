{
	"name": "laravel/laravel",
	"type": "project",
	"description": "The Laravel Framework.",
	"keywords": [
		"framework",
		"laravel"
	],
	"license": "MIT",
	"require": {
		"php": "^8.1",
		"barryvdh/laravel-dompdf": "^2.0",
		"barryvdh/laravel-snappy": "^1.0",
		"bavix/laravel-wallet": "^10.1",
		"beyondcode/laravel-websockets": "^1.14",
		"clickpaysa/laravel_package": "*",
		"darkaonline/l5-swagger": "*",
		"giggsey/libphonenumber-for-php": "^8.13",
		"guzzlehttp/guzzle": "^7.8",
		"h4cc/wkhtmltoimage-amd64": "0.12.x",
		"h4cc/wkhtmltopdf-amd64": "0.12.x",
		"intervention/image": "^2.7",
		"intervention/imagecache": "^2.6",
		"jantinnerezo/livewire-alert": "^2.2",
		"knplabs/knp-snappy": "^1.5",
		"kreait/firebase-php": "^7.14",
		"kutia-software-company/larafirebase": "^1.3",
		"laravel-validation-rules/credit-card": "^1.8",
		"laravel/framework": "^10.8",
		"laravel/horizon": "^5.23",
		"laravel/octane": "^2.12",
		"laravel/sanctum": "^3.2",
		"laravel/telescope": "^4.16",
		"laravel/tinker": "^2.8",
		"league/flysystem-aws-s3-v3": "3.0",
		"livewire/livewire": "*",
		"maatwebsite/excel": "^3.1",
		"matanyadaev/laravel-eloquent-spatial": "^3.1",
		"mcamara/laravel-localization": "^1.8",
		"moyasar/moyasar": "^1.1",
		"mpdf/mpdf": "^8.3",
		"predis/predis": "^2.2",
		"pusher/pusher-php-server": "^7.2",
		"rappasoft/laravel-livewire-tables": "^2.14",
		"salla/zatca": "^2.0",
		"spatie/laravel-collection-macros": "^7.12",
		"spatie/laravel-data": "^4.18",
		"spatie/laravel-medialibrary": "^10.9",
		"spatie/laravel-permission": "^5.10",
		"spatie/laravel-translatable": "^6.5",
		"spiral/roadrunner-cli": "^2.6.0",
		"spiral/roadrunner-http": "^3.3.0",
		"tiagomichaelsousa/laravelfilters": "^1.5"
	},
	"require-dev": {
		"barryvdh/laravel-debugbar": "^3.8",
		"beyondcode/laravel-er-diagram-generator": "^2.0",
		"fakerphp/faker": "^1.9.1",
		"laravel/breeze": "^1.21",
		"laravel/pint": "^1.0",
		"laravel/sail": "^1.18",
		"mockery/mockery": "^1.4.4",
		"nunomaduro/collision": "^7.0",
		"phpunit/phpunit": "^10.1",
		"spatie/laravel-ignition": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app/",
			"Domain\\": "app/Domain/",
			"Support\\": "app/Support/",
			"Application\\": "app/Application/",
			"Database\\Factories\\": "database/factories/",
			"Database\\Seeders\\": "database/seeders/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		},
		"files": [
			"app/Helpers/helpers.php"
		]
	},
	"scripts": {
		"post-autoload-dump": [
			"Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
			"@php artisan package:discover --ansi"
		],
		"post-update-cmd": [
			"@php artisan vendor:publish --tag=laravel-assets --ansi --force"
		],
		"post-root-package-install": [
			"@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
		],
		"post-create-project-cmd": [
			"@php artisan key:generate --ansi"
		]
	},
	"extra": {
		"laravel": {
			"dont-discover": []
		}
	},
	"config": {
		"optimize-autoloader": true,
		"preferred-install": "dist",
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true,
			"php-http/discovery": true
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
	
}
